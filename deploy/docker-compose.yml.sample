# session-timer — docker-compose deployment TEMPLATE.
#
# This file is NOT used from within the repository.  Copy it to the
# machine where the app is deployed and edit it there (image name, port,
# etc.).  Build and push the image first (see Dockerfile in the repo):
#
#   docker build -t REGISTRY/example/session-timer:TAG /path/to/session-timer
#   docker push REGISTRY/example/session-timer:TAG
#
# Deployment notes (all by design, see DESIGN.md):
# - State is memory-only by default: no volumes, no database.
#   Restarting the container loses every session; that is by design.
#   (Optional snapshots: see the commented lines below.)
# - Run exactly ONE replica of this service.  Containers do not share
#   state, so `--scale` or a second host behind the same DNS name would
#   hand users unrelated (empty) sessions.
# - The app serves plain HTTP on 8000; TLS termination belongs in a
#   reverse proxy in front of it.

services:
  session-timer:
    # CHANGE ME: registry/path/tag the image was pushed to — or replace
    # `image:` with `build:` pointing at a checkout on this host:
    #   build: /srv/session-timer
    image: ghcr.io/example/session-timer:latest
    container_name: session-timer
    restart: unless-stopped
    # Bind to the host loopback only: a reverse proxy listens publicly
    # (443) and forwards here.  Change to "8000:8000" to expose the
    # container directly.
    ports:
      - "127.0.0.1:8000:8000"
    # Container stdout logging (uvicorn access logs) — pick ONE:
    #
    # (1) True memory-only: log to the host journald configured with
    #     Storage=volatile, i.e. put this into /etc/systemd/journald.conf
    #     on the HOST (then `systemctl restart systemd-journald`):
    #
    #         [Journal]
    #         Storage=volatile
    #         SystemMaxUse=64M
    #
    #     The journal then lives only on the tmpfs /run (RAM, wiped on
    #     reboot) under the SystemMaxUse cap; logs stay readable via
    #     `journalctl` and `docker logs`.  NOTE: this is a HOST-wide
    #     setting — it affects ALL journald logging on the machine, not
    #     just this container.
    # logging:
    #   driver: journald
    #
    # (2) Bounded disk (recommended if journald-volatile is not wanted):
    #     json-file with rotation, so a request flood cannot fill the
    #     host disk.  `docker logs` works.  Sample max-size below; adjust
    #     to taste (e.g. "1m" with max-file "3" for a ~3 MB ceiling).
    # logging:
    #   driver: json-file
    #   options:
    #     max-size: "10m"
    #     max-file: "3"
    #
    # (3) Discard entirely: zero I/O of any kind, but `docker logs`
    #     shows nothing and a crash leaves only the exit code and the
    #     HEALTHCHECK status (snapshot-write errors become invisible).
    # logging:
    #   driver: none
    #
    # BONUS (combines with any of the above): drop access logs at the
    # source by overriding the command, keeping only lifecycle/error
    # lines (a few lines per boot regardless of request volume).  Keep
    # --no-server-header: it hides the "Server: uvicorn" fingerprint.
    # command: uvicorn session_timer.main:app --host 0.0.0.0 --port 8000 --no-access-log --no-server-header
    #
    # NOTE: the logging driver is fixed at container creation time —
    # switching requires `docker compose up -d --force-recreate`.

    # No volumes on purpose (memory-only state).
    #
    # OPTIONAL: persist sessions across restarts by uncommenting these
    # lines (the app then writes a snapshot into the volume every 5
    # minutes and on graceful shutdown; a hard kill can lose the last
    # few minutes of edits):
    #
    # environment:
    #   - SESSION_TIMER_DATA_DIR=/data
    # volumes:
    #   - ./session-timer-data:/data
